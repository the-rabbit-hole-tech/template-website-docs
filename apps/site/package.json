{
  "name": "@product/site",
  "private": true,
  "type": "module",
  "description": "The {{PRODUCT}} product site, {{DOMAIN}}.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:coming-soon": "SITE_COMING_SOON=true react-router build && node --experimental-strip-types scripts/check-release-build.ts build/client",
    "preview": "npx serve build/client",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test app/*.test.ts app/content/*.test.ts scripts/*.test.ts",
    "check:links": "node scripts/check-links.mjs build/client"
  },
  "dependencies": {
    "@product/brand": "*",
    "@product/frame": "*",
    "@react-router/node": "^7.18.4",
    "isbot": "^5.1.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
